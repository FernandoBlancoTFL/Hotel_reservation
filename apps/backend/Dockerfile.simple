FROM node:18-alpine AS builder

WORKDIR /app

# Copiar tsconfig raíz
COPY tsconfig.json ./

# Copiar y construir domain
COPY domain/package*.json ./domain/
COPY domain/tsconfig.json ./domain/
COPY domain/src ./domain/src

WORKDIR /app/domain
RUN npm install
RUN npm run build

# Copiar y construir backend
WORKDIR /app
COPY apps/backend/package*.json ./apps/backend/
COPY apps/backend/tsconfig.json ./apps/backend/
COPY apps/backend/src ./apps/backend/src

WORKDIR /app/apps/backend
RUN npm install
RUN npm run build

FROM node:18-alpine

WORKDIR /app

# Copiar domain construido
COPY --from=builder /app/domain/dist ./domain/dist
COPY --from=builder /app/domain/package*.json ./domain/
COPY --from=builder /app/domain/node_modules ./domain/node_modules

# Copiar backend construido
COPY --from=builder /app/apps/backend/dist ./apps/backend/dist
COPY --from=builder /app/apps/backend/package*.json ./apps/backend/
COPY --from=builder /app/apps/backend/node_modules ./apps/backend/node_modules

ENV NODE_ENV=production

EXPOSE 3000

CMD ["node", "apps/backend/dist/index.js"]